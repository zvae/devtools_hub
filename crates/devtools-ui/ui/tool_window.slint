import { Button, ListView } from "std-widgets.slint";
import { EditorPane } from "editor_pane.slint";
import { ToolHistoryView } from "common.slint";

// 独立工具窗口：使用系统原生窗口按钮，内部只保留置顶控制。
export component ToolWindow inherits Window {
    in-out property <string> tool-id;
    in-out property <string> title-text;
    in-out property <string> input;
    in-out property <string> output;
    in-out property <bool> dark-mode;
    in-out property <bool> pinned;
    in-out property <string> language;
    in property <[ToolHistoryView]> history;
    in-out property <bool> history-visible;

    callback run(string);
    callback select-history(int);
    callback toggle-history;
    callback copy-output;
    callback toggle-pin;

    title: root.title-text;
    icon: @image-url("../../../assets/devtools-hub.png");
    preferred-width: 860px;
    preferred-height: 560px;
    min-width: 620px;
    min-height: 420px;
    resize-border-width: 8px;
    always-on-top: root.pinned;
    background: root.dark-mode ? #0f141d : #f3f6fb;

    // 输入/输出区域使用弹性布局，窗口最大化或拖拽缩放时自动拉伸。
    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Rectangle {
            height: 46px;
            background: transparent;

            HorizontalLayout {
                spacing: 12px;

                Text {
                    text: root.title-text;
                    color: root.dark-mode ? #f4f7fb : #142033;
                    font-size: 22px;
                    font-weight: 800;
                    overflow: elide;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // 置顶按钮放在内容区右上角，避免定制系统标题栏。
                Rectangle {
                    width: 72px;
                    height: 34px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: root.pinned ? #5ea1ff : (root.dark-mode ? #303a4e : #d9e0ea);
                    background: root.pinned ? (root.dark-mode ? #203555 : #eaf2ff) : (root.dark-mode ? #151c28 : #ffffff);

                    Text {
                        text: root.language == "en" ? "Top" : "置顶";
                        color: root.pinned ? (root.dark-mode ? #eaf3ff : #1c4e91) : (root.dark-mode ? #d2d9e4 : #2d3748);
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.toggle-pin();
                        }
                    }
                }
            }
        }

        // 工具输入和输出并排展示，后续可按工具类型替换成专用 UI。
        HorizontalLayout {
            spacing: 12px;
            vertical-stretch: 1;

            EditorPane {
                label: root.language == "en" ? "Input" : "输入";
                dark-mode: root.dark-mode;
                text <=> root.input;
                read-only: false;
                edited(value) => {
                    root.run(value);
                }
                horizontal-stretch: 1;
            }

            EditorPane {
                label: root.language == "en" ? "Output" : "输出";
                dark-mode: root.dark-mode;
                text <=> root.output;
                read-only: true;
                horizontal-stretch: 1;
            }
        }

        if root.history-visible: Rectangle {
            height: 132px;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.dark-mode ? #2f3a4f : #d9e0ea;
            background: root.dark-mode ? #121926 : #ffffff;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                Text {
                    text: root.language == "en" ? "History" : "历史记录";
                    color: root.dark-mode ? #8f9aae : #637083;
                    font-size: 12px;
                    font-weight: 700;
                    height: 20px;
                }

                ListView {
                    for item[index] in root.history: Rectangle {
                        height: 32px;
                        background: history-touch.has-hover ? (root.dark-mode ? #202b3e : #eef4fc) : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            Text {
                                text: item.summary;
                                color: root.dark-mode ? #dce4f0 : #263448;
                                font-size: 12px;
                                overflow: elide;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            Text {
                                text: item.created-at;
                                color: root.dark-mode ? #7f8da3 : #7a8697;
                                font-size: 11px;
                                width: 48px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        history-touch := TouchArea {
                            clicked => {
                                root.select-history(index);
                            }
                        }
                    }
                }
            }
        }

        // 底部操作栏：自动计算结果，保留历史展开与复制操作。
        Rectangle {
            height: 42px;
            background: transparent;

            HorizontalLayout {
                spacing: 10px;

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Button {
                    text: root.language == "en" ? "History" : "历史";
                    clicked => {
                        root.toggle-history();
                    }
                }

                Button {
                    text: root.language == "en" ? "Copy" : "复制";
                    clicked => {
                        root.copy-output();
                    }
                }
            }
        }
    }
}
