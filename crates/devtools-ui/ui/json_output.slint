import { ListView, ScrollView } from "std-widgets.slint";
import { IconButton } from "icon_button.slint";
import { SectionLabel } from "common.slint";

export struct JsonLineView {
    line-id: int,
    number: string,
    text: string,
    expandable: bool,
    collapsed: bool,
}

export component JsonOutput inherits Rectangle {
    in property <[JsonLineView]> lines;
    in property <string> display-text;
    in property <bool> dark-mode;
    in property <string> language;
    callback toggle-fold(int);
    callback fold-all(bool);

    border-radius: 8px;
    border-width: 1px;
    border-color: root.dark-mode ? #2f3a4f : #d9e0ea;
    background: root.dark-mode ? #121926 : #ffffff;
    min-width: 160px;
    // Derive gutter spacing from the same text layout used by the continuous editor.
    private property <length> line-height: editor.preferred-height / max(1, root.lines.length);

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            SectionLabel {
                text: root.language == "en" ? "Output" : "输出";
                dark-mode: root.dark-mode;
                horizontal-stretch: 1;
            }
            IconButton {
                dark-mode: root.dark-mode;
                icon: @image-url("../../../assets/icons/chevron-right.svg");
                description: root.language == "en" ? "Collapse all" : "全部折叠";
                clicked => { root.fold-all(true); }
            }
            IconButton {
                dark-mode: root.dark-mode;
                icon: @image-url("../../../assets/icons/chevron-down.svg");
                description: root.language == "en" ? "Expand all" : "全部展开";
                clicked => { root.fold-all(false); }
            }
        }
        HorizontalLayout {
            spacing: 0px;
            gutter := ListView {
                width: 80px;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: always-off;
                viewport-y <=> scroll.viewport-y;
                for line in root.lines: Rectangle {
                    height: root.line-height;
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            width: 48px;
                            text: line.number;
                            color: root.dark-mode ? #8492a8 : #65748a;
                            font-family: "Menlo";
                            font-size: 12px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 26px;
                            if line.expandable: IconButton {
                                dark-mode: root.dark-mode;
                                width: 26px;
                                height: root.line-height;
                                icon: line.collapsed ? @image-url("../../../assets/icons/chevron-right.svg") : @image-url("../../../assets/icons/chevron-down.svg");
                                description: (line.collapsed ? (root.language == "en" ? "Expand line " : "展开第 ") : (root.language == "en" ? "Collapse line " : "折叠第 ")) + line.number + (root.language == "en" ? "" : " 行");
                                clicked => { root.toggle-fold(line.line-id); }
                            }
                        }
                    }
                }
            }
            ContextMenuArea {
                Menu {
                    MenuItem {
                        title: root.language == "en" ? "Copy" : "复制";
                        activated => { editor.copy(); }
                    }
                    MenuItem {
                        title: root.language == "en" ? "Select All" : "全选";
                        activated => { editor.focus(); editor.select-all(); }
                    }
                }
                scroll := ScrollView {
                    viewport-width: max(self.visible-width, editor.preferred-width);
                    viewport-height: max(self.visible-height, editor.preferred-height);
                    editor := TextInput {
                        text: root.display-text;
                        read-only: true;
                        single-line: false;
                        wrap: no-wrap;
                        font-family: "Menlo";
                        font-size: 14px;
                        color: root.dark-mode ? #dce4f0 : #263448;
                        selection-background-color: #315fa0;
                        selection-foreground-color: #ffffff;
                        page-height: scroll.visible-height;
                        accessible-label: root.language == "en" ? "JSON output" : "JSON 输出";
                        cursor-position-changed(position) => {
                            if position.x + scroll.viewport-x < 0px {
                                scroll.viewport-x = min(0px, max(scroll.visible-width - self.width, -position.x));
                            } else if position.x + scroll.viewport-x > scroll.visible-width - self.text-cursor-width {
                                scroll.viewport-x = min(0px, max(scroll.visible-width - self.width, scroll.visible-width - position.x - self.text-cursor-width));
                            }
                            if position.y + scroll.viewport-y < 0px {
                                scroll.viewport-y = min(0px, max(scroll.visible-height - self.height, -position.y));
                            } else if position.y + scroll.viewport-y > scroll.visible-height - root.line-height {
                                scroll.viewport-y = min(0px, max(scroll.visible-height - self.height, scroll.visible-height - position.y - root.line-height));
                            }
                        }
                    }
                }
            }
        }
    }
}
