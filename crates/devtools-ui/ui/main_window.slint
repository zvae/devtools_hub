import { LineEdit } from "std-widgets.slint";
import { NavButton, ResultList, SearchResultView } from "common.slint";
import { SettingsPanel } from "settings_panel.slint";

// 主窗口：左侧导航固定，右侧根据 active-view 切换搜索、工具、设置页面。
export component SearchWindow inherits Window {
    in-out property <string> query;
    in property <[SearchResultView]> results;
    in property <[SearchResultView]> tools;
    in-out property <int> active-view;
    in-out property <bool> dark-mode;
    in-out property <string> language;
    in-out property <string> settings-theme;
    in-out property <string> settings-hotkey;
    in-out property <string> status;

    callback query-changed(string);
    callback activate-result(int);
    callback activate-tool(int);
    callback show-search;
    callback show-tools;
    callback show-settings;
    callback theme-selected(string);
    callback language-selected(string);
    callback hotkey-changed(string);
    callback clear-clipboard;

    title: "DevTools Hub";
    preferred-width: 760px;
    preferred-height: 540px;
    min-width: 680px;
    min-height: 460px;
    resize-border-width: 8px;
    background: root.dark-mode ? #0f141d : #f3f6fb;

    // 外层横向布局保持 uTools 风格：导航和内容区并排。
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;

        Rectangle {
            width: 168px;
            border-radius: 8px;
            background: root.dark-mode ? #111824 : #ffffff;
            border-width: 1px;
            border-color: root.dark-mode ? #222c3e : #e0e6ef;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "DevTools";
                    color: root.dark-mode ? #f4f7fb : #142033;
                    font-size: 18px;
                    font-weight: 800;
                    height: 42px;
                    vertical-alignment: center;
                }

                NavButton {
                    text: root.language == "en" ? "Search" : "搜索";
                    icon: "/";
                    selected: root.active-view == 0;
                    dark-mode: root.dark-mode;
                    clicked => {
                        root.show-search();
                    }
                }

                NavButton {
                    text: root.language == "en" ? "Tools" : "工具";
                    icon: "#";
                    selected: root.active-view == 1;
                    dark-mode: root.dark-mode;
                    clicked => {
                        root.show-tools();
                    }
                }

                NavButton {
                    text: root.language == "en" ? "Settings" : "设置";
                    icon: "*";
                    selected: root.active-view == 2;
                    dark-mode: root.dark-mode;
                    clicked => {
                        root.show-settings();
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: root.status;
                    color: root.dark-mode ? #7f8da3 : #6b7688;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: transparent;
            horizontal-stretch: 1;

            VerticalLayout {
                spacing: 12px;

                // 使用条件组件而不是 visible，避免隐藏页面继续占用布局空间。
                if root.active-view == 0: Rectangle {
                    background: transparent;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 12px;

                        Rectangle {
                            height: 54px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: root.dark-mode ? #263249 : #dfe6ef;
                            background: root.dark-mode ? #151d2b : #ffffff;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 10px;

                                Text {
                                    text: ">";
                                    color: #5ea1ff;
                                    width: 18px;
                                    font-size: 18px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    text: root.query;
                                    placeholder-text: root.language == "en" ? "Search commands, tools and settings" : "搜索命令、工具和设置";
                                    font-size: 18px;
                                    edited(value) => {
                                        root.query = value;
                                        root.query-changed(value);
                                    }
                                    accepted(value) => {
                                        root.query = value;
                                        root.query-changed(value);
                                        root.activate-result(0);
                                    }
                                }
                            }
                        }

                        ResultList {
                            rows: root.results;
                            dark-mode: root.dark-mode;
                            vertical-stretch: 1;
                            activate-row(index) => {
                                root.activate-result(index);
                            }
                        }
                    }
                }

                // 工具页只展示工具命令，具体工具界面在独立窗口中打开。
                if root.active-view == 1: Rectangle {
                    background: transparent;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: root.language == "en" ? "Tools" : "工具";
                            color: root.dark-mode ? #f4f7fb : #142033;
                            font-size: 24px;
                            font-weight: 800;
                            height: 42px;
                            vertical-alignment: center;
                        }

                        ResultList {
                            rows: root.tools;
                            dark-mode: root.dark-mode;
                            vertical-stretch: 1;
                            activate-row(index) => {
                                root.activate-tool(index);
                            }
                        }
                    }
                }

                // 设置页承载主题、语言、快捷键和本地数据操作。
                if root.active-view == 2: Rectangle {
                    background: transparent;
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: root.language == "en" ? "Settings" : "设置";
                            color: root.dark-mode ? #f4f7fb : #142033;
                            font-size: 24px;
                            font-weight: 800;
                            height: 42px;
                            vertical-alignment: center;
                        }

                        SettingsPanel {
                            dark-mode: root.dark-mode;
                            language: root.language;
                            settings-theme <=> root.settings-theme;
                            settings-hotkey <=> root.settings-hotkey;
                            theme-selected(value) => {
                                root.theme-selected(value);
                            }
                            language-selected(value) => {
                                root.language-selected(value);
                            }
                            hotkey-changed(value) => {
                                root.hotkey-changed(value);
                            }
                            clear-clipboard => {
                                root.clear-clipboard();
                            }
                        }
                    }
                }
            }
        }
    }
}
