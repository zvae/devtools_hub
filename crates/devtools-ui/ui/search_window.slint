// UI 聚合入口：Rust 构建脚本只编译这个文件，其它窗口组件从这里统一导出。
// 重新导出 Palette global，让 Rust 端可以通过 window.global::<Palette>() 设置 color-scheme，
// 使标准组件（如 TextEdit）的内置背景跟随应用主题，而非系统暗黑模式。
import { Palette } from "std-widgets.slint";
export { Palette }
export { SearchWindow } from "main_window.slint";
export { ToolWindow } from "tool_window.slint";
export { JsonLineView } from "json_output.slint";
export { ClipboardWindow } from "clipboard_window.slint";
export { QuickActionWindow } from "quick_action_window.slint";
export { SearchResultView } from "common.slint";
export { ToolHistoryView } from "common.slint";
export { TimestampWindow } from "timestamp_window.slint";
