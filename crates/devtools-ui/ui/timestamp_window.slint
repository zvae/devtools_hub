import { Button, ComboBox } from "std-widgets.slint";

component CopyField inherits Rectangle {
    in property <string> text;
    in property <bool> dark-mode;
    callback copy(string);

    height: 42px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.dark-mode ? #303a4e : #dbe3ed;
    background: root.dark-mode ? #151c28 : #ffffff;

    Text {
        text: root.text;
        color: root.dark-mode ? #f3f6fb : #172033;
        font-size: 17px;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.copy(root.text); }
    }
}

component TimestampInput inherits TextInput {
    in property <bool> dark-mode;
    height: 42px;
    color: root.dark-mode ? #f3f6fb : #172033;
    selection-foreground-color: root.dark-mode ? #0f141d : #ffffff;
    selection-background-color: #5ea1ff;
    font-size: 17px;
    horizontal-alignment: center;
    vertical-alignment: center;
}

// 专用时间戳表单采用稳定的行布局，避免网格列宽在原生后端被拉伸。
export component TimestampWindow inherits Window {
    in-out property <bool> dark-mode;
    in-out property <string> current-timestamp;
    in-out property <int> current-unit-index: 1;
    in-out property <string> timestamp-input;
    in-out property <string> datetime-output;
    in-out property <string> datetime-input;
    in-out property <string> datetime-timestamp-output;
    in-out property <int> datetime-unit-index: 1;
    in-out property <string> year-input;
    in-out property <string> month-input;
    in-out property <string> day-input;
    in-out property <string> hour-input;
    in-out property <string> minute-input;
    in-out property <string> second-input;
    in-out property <string> parts-output;
    in-out property <int> parts-unit-index: 1;

    callback refresh-current;
    callback start-clock;
    callback stop-clock;
    callback current-unit-changed(int);
    callback convert-timestamp(string);
    callback convert-datetime(string, int);
    callback convert-parts(string, string, string, string, string, string, int);
    callback copy-text(string);

    title: "Timestamp Convert";
    icon: @image-url("../../../assets/devtools-hub.png");
    // 日期分项转换行需要保持输入框、单位和结果在同一行，不能让原生后端压缩后重排。
    preferred-width: 1020px;
    preferred-height: 500px;
    min-width: 960px;
    min-height: 450px;
    resize-border-width: 8px;
    background: root.dark-mode ? #0f141d : #f5f8fc;

    VerticalLayout {
        padding: 22px;
        spacing: 16px;

        Text {
            text: "结果框点击即可复制到剪贴板";
            color: root.dark-mode ? #8f9aae : #708096;
            font-size: 13px;
            horizontal-alignment: right;
            height: 20px;
        }

        Rectangle {
            height: 64px;
            background: transparent;

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Text { text: "当前时间戳"; color: root.dark-mode ? #dce4f0 : #526176; font-size: 21px; vertical-alignment: center; }
                CopyField { width: 216px; text: root.current-timestamp; dark-mode: root.dark-mode; copy(value) => { root.copy-text(value); } }
                ComboBox {
                    width: 82px;
                    model: ["秒", "毫秒"];
                    current-index <=> root.current-unit-index;
                    selected => { root.current-unit-changed(root.current-unit-index); }
                }
                Button { text: "开始"; clicked => { root.start-clock(); } }
                Button { text: "停止"; clicked => { root.stop-clock(); } }
                Button { text: "刷新"; clicked => { root.refresh-current(); } }
            }
        }

        Rectangle { height: 1px; background: root.dark-mode ? #293449 : #e1e8f0; }

        Rectangle {
            height: 54px;
            background: transparent;
            HorizontalLayout {
                spacing: 12px;
                Text { width: 118px; text: "时间戳"; color: root.dark-mode ? #dce4f0 : #526176; font-size: 18px; vertical-alignment: center; }
                TimestampInput { width: 230px; text <=> root.timestamp-input; dark-mode: root.dark-mode; }
                Button { width: 84px; text: "转换"; clicked => { root.convert-timestamp(root.timestamp-input); } }
                CopyField { horizontal-stretch: 1; text: root.datetime-output; dark-mode: root.dark-mode; copy(value) => { root.copy-text(value); } }
                Text { width: 56px; text: "+08:00"; color: root.dark-mode ? #8f9aae : #708096; font-size: 14px; vertical-alignment: center; }
            }
        }

        Rectangle {
            height: 54px;
            background: transparent;
            HorizontalLayout {
                spacing: 12px;
                Text { width: 118px; text: "时间"; color: root.dark-mode ? #dce4f0 : #526176; font-size: 18px; vertical-alignment: center; }
                TimestampInput { width: 230px; text <=> root.datetime-input; dark-mode: root.dark-mode; }
                Button { width: 132px; text: "转时间戳"; clicked => { root.convert-datetime(root.datetime-input, root.datetime-unit-index); } }
                CopyField { horizontal-stretch: 1; text: root.datetime-timestamp-output; dark-mode: root.dark-mode; copy(value) => { root.copy-text(value); } }
                ComboBox {
                    width: 82px;
                    model: ["秒", "毫秒"];
                    current-index <=> root.datetime-unit-index;
                    selected => { root.convert-datetime(root.datetime-input, root.datetime-unit-index); }
                }
            }
        }

        Rectangle { height: 1px; background: root.dark-mode ? #293449 : #e1e8f0; }

        Rectangle {
            height: 76px;
            background: transparent;
            HorizontalLayout {
                spacing: 7px;
                Text { width: 54px; text: "时间"; color: root.dark-mode ? #dce4f0 : #526176; font-size: 18px; vertical-alignment: center; }
                TimestampInput { width: 70px; text <=> root.year-input; dark-mode: root.dark-mode; }
                Text { width: 18px; text: "年"; color: root.dark-mode ? #dce4f0 : #526176; vertical-alignment: center; }
                TimestampInput { width: 48px; text <=> root.month-input; dark-mode: root.dark-mode; }
                Text { width: 18px; text: "月"; color: root.dark-mode ? #dce4f0 : #526176; vertical-alignment: center; }
                TimestampInput { width: 48px; text <=> root.day-input; dark-mode: root.dark-mode; }
                Text { width: 18px; text: "日"; color: root.dark-mode ? #dce4f0 : #526176; vertical-alignment: center; }
                TimestampInput { width: 48px; text <=> root.hour-input; dark-mode: root.dark-mode; }
                Text { width: 18px; text: "时"; color: root.dark-mode ? #dce4f0 : #526176; vertical-alignment: center; }
                TimestampInput { width: 48px; text <=> root.minute-input; dark-mode: root.dark-mode; }
                Text { width: 18px; text: "分"; color: root.dark-mode ? #dce4f0 : #526176; vertical-alignment: center; }
                TimestampInput { width: 48px; text <=> root.second-input; dark-mode: root.dark-mode; }
                Text { width: 18px; text: "秒"; color: root.dark-mode ? #dce4f0 : #526176; vertical-alignment: center; }
                Button { width: 126px; text: "转时间戳"; clicked => { root.convert-parts(root.year-input, root.month-input, root.day-input, root.hour-input, root.minute-input, root.second-input, root.parts-unit-index); } }
                CopyField { width: 150px; text: root.parts-output; dark-mode: root.dark-mode; copy(value) => { root.copy-text(value); } }
                ComboBox {
                    width: 82px;
                    model: ["秒", "毫秒"];
                    current-index <=> root.parts-unit-index;
                    selected => { root.convert-parts(root.year-input, root.month-input, root.day-input, root.hour-input, root.minute-input, root.second-input, root.parts-unit-index); }
                }
            }
        }
    }
}
